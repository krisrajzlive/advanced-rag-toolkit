OPENAI_API_KEY=

# Hugging Face Inference Providers token (free tier) - default LLM +
# embedding + image/audio fallback provider for every demo
HUGGINGFACE_API_KEY=

# Ollama Cloud API key (free tier) - alternate LLM provider
OLLAMA_API_KEY=

# LangSmith tracing + evaluation (used by src/evaluation/langsmith_eval.py)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=advanced-rag-toolkit

# --- local Docker stack (docker-compose.yml) ---
# Pick any values for the three passwords; the demo users in the Keycloak
# realm are created with RAG_DEMO_PASSWORD on first start.
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=rag
KEYCLOAK_CLIENT_ID=rag-api
KEYCLOAK_ADMIN_PASSWORD=
RAG_DEMO_PASSWORD=
# Optional: force one LLM provider (huggingface | ollama | openai)
# RAG_LLM_PROVIDER=ollama
